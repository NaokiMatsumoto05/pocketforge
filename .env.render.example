# Backend-only settings for Render Free + Neon Free.
# Never commit actual values or use EXPO_PUBLIC_* for credentials.
NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=1
ALLOW_REGISTRATION=false
# Neon pooled PostgreSQL URL (TLS certificate verification is always enabled).
DATABASE_URL=
# Fixed 64 hex characters. Generate once and back up with the database.
VAULT_KEY=
# PUBLIC_ORIGIN defaults to Render's RENDER_EXTERNAL_URL.
