# API is local-only by default. Serve behind HTTPS before using remotely.
HOST=127.0.0.1
PORT=4310
DATA_DIR=.data
PUBLIC_ORIGIN=http://localhost:4310
ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310,http://localhost:8081
ALLOW_REGISTRATION=true
# Production: 64 hex characters, keep in a secret manager. Local mode generates a file.
# VAULT_KEY=
# EXPO_PUBLIC_API_URL=https://your-api.example.com
# Pin your own E2B template with Node.js, Python3, git and required CPU/memory/disk limits.
E2B_TEMPLATE=base
SANDBOX_TIMEOUT_MS=600000
