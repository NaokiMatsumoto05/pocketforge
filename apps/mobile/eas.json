{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.16.0",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.16.0",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "production": { "autoIncrement": true, "environment": "production", "node": "24.16.0" }
  }
}
