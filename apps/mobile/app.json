{
  "expo": {
    "name": "PocketForge",
    "slug": "pocketforge",
    "version": "0.1.0",
    "scheme": "pocketforge",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pocketforge.studio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.pocketforge.studio"
    },
    "web": {
      "bundler": "metro",
      "name": "PocketForge — ひらめきを、手のひらから。",
      "shortName": "PocketForge",
      "themeColor": "#fafafa"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a1c5e84a-7445-436f-826b-e547f2ca1a5f"
      }
    },
    "owner": "matsumoto-naoki"
  }
}
