# Copy to .env.server on the backend host only. chmod 600 .env.server
POCKETFORGE_DOMAIN=forge.example.com
PUBLIC_ORIGIN=https://forge.example.com
ALLOWED_ORIGINS=https://forge.example.com
# Generate 32 random bytes as 64 hex characters; keep unchanged and back up securely.
VAULT_KEY=
E2B_TEMPLATE=base
SANDBOX_TIMEOUT_MS=600000
# AI and E2B keys are registered through the app after login.
# Never put them in EXPO_PUBLIC_* variables or client source.
